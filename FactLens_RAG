tarted":"2025-11-14T19:06:56.574594Z","shell.execute_reply":"2025-11-14T19:06:56.683145Z"}},"outputs":[{"name":"stdout","text":"(1, 768)\n","output_type":"stream"}],"execution_count":172},{"id":"267ef810-2949-4206-94a1-607b5b16a951","cell_type":"markdown","source":"## Retrieval (FAISS + COhere Embeddings)","metadata":{}},{"id":"ccf9c371-7e94-4458-899b-3351c85b2203","cell_type":"code","source":"def retrieve(claim, k=8):\n    q = embed_query(claim)                     # (1, 384)\n    D, I = index.search(q, k)                  # real FAISS distances\n\n    results = []\n    for score, idx in zip(D[0], I[0]):\n        row = wiki[idx]\n        results.append({\n            \"title\": row[\"title\"],\n            \"text\": row[\"text\"],\n            \"url\": row[\"url\"],\n            \"score\": float(score)              # correct score\n        })\n\n    # sort by FAISS similarity (descending)\n    results = sorted(results, key=lambda x: x[\"score\"], reverse=True)\n\n    return results","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-14T19:06:56.684517Z","iopub.execute_input":"2025-11-14T19:06:56.685026Z","iopub.status.idle":"2025-11-14T19:06:56.689669Z","shell.execute_reply.started":"2025-11-14T19:06:56.685008Z","shell.execute_reply":"2025-11-14T19:06:56.688922Z"}},"outputs":[],"execution_count":173},{"id":"7e233f21-1bb8-4290-bf7c-239a355db767","cell_type":"markdown","source":"## NLI classifier","metadata":{}},{"id":"e7cd740a-5ebe-4a95-a0ff-eb4a48fdea14","cell_type":"code","source":"nli_tok = AutoTokenizer.from_pretrained(\"MoritzLaurer/deberta-v3-base-mnli\")\nnli_model = AutoModelForSequenceClassification.from_pretrained(\n    \"MoritzLaurer/deberta-v3-base-mnli\"\n).to(\"cuda\")\n\nid2label = {0: \"REFUTES\", 1: \"NOT ENOUGH INFO\", 2: \"SUPPORTS\"}\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-14T19:06:56.690478Z","iopub.execute_input":"2025-11-14T19:06:56.690750Z","iopub.status.idle":"2025-11-14T19:07:00.292226Z","shell.execute_reply.started":"2025-11-14T19:06:56.690729Z","shell.execute_reply":"2025-11-14T19:07:00.291654Z"}},"outputs":[],"execution_count":174},{"id":"c7dcaf7e-c335-4771-9945-a987a3fcc837","cell_type":"markdown","source":"## NLI inference","metadata":{}},{"id":"a485b27f-8c58-4e6c-99bf-2546a06e58fe","cell_type":"code","source":"def classify(claim, evidence):\n    x = nli_tok(\n        claim,\n        evidence,\n        return_tensors=\"pt\",\n        truncation=True,\n        max_length=256\n    ).to(\"cuda\")\n\n    with torch.no_grad():\n        logits = nli_model(**x).logits\n        probs = logits.softmax(dim=1)[0]\n\n    pred = logits.argmax().item()\n    return id2label[pred], float(probs[pred])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-14T19:07:00.295096Z","iopub.execute_input":"2025-11-14T19:07:00.295478Z","iopub.status.idle":"2025-11-14T19:07:00.300084Z","shell.execute_reply.started":"2025-11-14T19:07:00.295457Z","shell.execute_reply":"2025-11-14T19:07:00.299172Z"}},"outputs":[],"execution_count":175},{"id":"f18e1eec-2dae-46ae-a599-533ab2be6e7d","cell_type":"code","source":"def hard_filter(results, claim):\n    claim_low = claim.lower()\n    filtered = []\n\n    for r in results:\n        t = r[\"title\"].lower()\n        if any(w in t for w in claim_low.split()):\n            filtered.append(r)\n\n    return filtered if filtered else results\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-14T19:07:00.301073Z","iopub.execute_input":"2025-11-14T19:07:00.301378Z","iopub.status.idle":"2025-11-14T19:07:00.316210Z","shell.execute_reply.started":"2025-11-14T19:07:00.301353Z","shell.execute_reply":"2025-11-14T19:07:00.315436Z"}},"outputs":[],"execution_count":176},{"id":"278d9629-e00c-4752-a0b2-adf8a7387cb9","cell_type":"markdown","source":"## Fact checker","metadata":{}},{"id":"03a9324d-371d-4bfd-a5df-0cc6dad92ed7","cell_type":"code","source":"def fact_check(claim, k=8):\n    retrieved = retrieve(claim, k=k)\n    retrieved = hard_filter(retrieved, claim)\n    # classify each chunk\n    chunk_results = []\n    for r in retrieved:\n        label, conf = classify(claim, r[\"text\"])\n        chunk_results.append((label, conf, r))\n\n    # final decision logic\n    # highest confidence SUPPORTS wins\n    supports = [x for x in chunk_results if x[0] == \"SUPPORTS\"]\n    refutes  = [x for x in chunk_results if x[0] == \"REFUTES\"]\n\n    if supports:\n        best = max(supports, key=lambda x: x[1])\n        final_label = \"SUPPORTS\"\n        final_conf = best[1]\n    elif refutes:\n        best = max(refutes, key=lambda x: x[1])\n        final_label = \"REFUTES\"\n        final_conf = best[1]\n    else:\n        # all NEI, so choose best NEI\n        best = max(chunk_results, key=lambda x: x[1])\n        final_label = \"NOT ENOUGH INFO\"\n        final_conf = best[1]\n\n    return {\n        \"claim\": claim,\n        \"label\": final_label,\n        \"confidence\": final_conf,\n        \"top_evidence\": [x[2] for x in chunk_results]\n    }","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-14T19:07:00.316957Z","iopub.execute_input":"2025-11-14T19:07:00.317133Z","iopub.status.idle":"2025-11-14T19:07:00.331019Z","shell.execute_reply.started":"2025-11-14T19:07:00.317119Z","shell.execute_reply":"2025-11-14T19:07:00.330323Z"}},"outputs":[],"execution_count":177},{"id":"0ed93607-844c-41cd-ac66-abdc7d0d74ef","cell_type":"code","source":"claim = \"Albert Einstein was a physicist\"\nresult = fact_check(claim)\nresult","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-14T19:07:00.331702Z","iopub.execute_input":"2025-11-14T19:07:00.331945Z","iopub.status.idle":"2025-11-14T19:07:00.613017Z","shell.execute_reply.started":"2025-11-14T19:07:00.331925Z","shell.execute_reply":"2025-11-14T19:07:00.612454Z"}},"outputs":[{"execution_count":178,"output_type":"execute_result","data":{"text/plain":"{'claim': 'Albert Einstein was a physicist',\n 'label': 'SUP